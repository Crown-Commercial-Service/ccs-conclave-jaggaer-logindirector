{
  "AWS": {
    "Profile": "dev",
    "ProfilesLocation=": "~/.aws/config",
    "Region": "eu-west-2"
  },
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:2021"
      }
    }
  }
}
