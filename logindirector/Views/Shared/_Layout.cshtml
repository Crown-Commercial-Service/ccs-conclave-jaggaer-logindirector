@using StackExchange.Profiling
@addTagHelper *, MiniProfiler.AspNetCore.Mvc

<!DOCTYPE html>
<html lang="en" class="govuk-template">
    <head>
        <meta charset="utf-8">
        
        @if (ViewData["Title"] != null && !String.IsNullOrWhiteSpace(ViewData["Title"].ToString()))
        {
            <title>@ViewData["Title"] | Login Director | Government Commercial Agency</title>
        } else {
            <title>Login Director | Government Commercial Agency</title>
        }

        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#0b0c0c">
        <meta name="robots" content="noindex,nofollow" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge">

        <link rel="shortcut icon" sizes="16x16 32x32 48x48" href="/public/assets/images/favicon.svg" type="image/x-icon">
        <link rel="mask-icon" href="/public/assets/images/ccs-mask-icon.svg" color="#0b0c0c">
        <link rel="apple-touch-icon" sizes="180x180" href="/public/assets/images/ccs-apple-touch-icon-180x180.png">
        <link rel="apple-touch-icon" sizes="167x167" href="/public/assets/images/ccs-apple-touch-icon-167x167.png">
        <link rel="apple-touch-icon" sizes="152x152" href="/public/assets/images/ccs-apple-touch-icon-152x152.png">
        <link rel="apple-touch-icon" href="/public/assets/images/ccs-apple-touch-icon.png">
        <meta property="og:image" content="/public/assets/images/ccs-opengraph-image.png" />

        <link rel="stylesheet" href="~/public/assets/application.css">
    </head>

    <body class="govuk-template__body">
        <mini-profiler position="@RenderPosition.Right" max-traces="5" />

        <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>
        
        @await Html.PartialAsync("~/Views/Header/Header.cshtml")
        
        <main id="main-content" role="main" class="govuk-main-wrapper" data-template="">
            <div class="govuk-width-container">
                @RenderBody()
            </div>
        </main>

        @await Html.PartialAsync("~/Views/Footer/Footer.cshtml")
        
        <script src="~/public/assets/application.js" asp-append-version="true"></script>
    </body>
</html>